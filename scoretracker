import tkinter as tk
from tkinter import messagebox
from openpyxl import load_workbook, Workbook
from openpyxl.styles import Font
from openpyxl.utils import get_column_letter
import os

def validate_inputs():
    name = name_entry.get()
    grade = grade_entry.get()

    if not name or not grade:
        messagebox.showerror("Input Error", "All fields are required!")
        return False
    return True

def save_to_excel():
    if not validate_inputs():
        return
    
    name = name_entry.get()
    grade = grade_entry.get()

    file_path = "studgrade.xlsx"
    if not os.path.exists(file_path):
        wb = Workbook()
        ws = wb.active
        ws.title = "Student Grade"
        ws.append(["Name", "Score", "Remarks"])
    else:
        wb = load_workbook("studgrade.xlsx")
        ws = wb["Student Grade"]

    if grade.isdigit() and int(grade)>=75:
        remarks = "Passed"
    else:
        remarks = "Failed"

    ws.append([name, grade,remarks])
    wb.save("studgrade.xlsx")

    format_excel()  
    messagebox.showinfo("Success", "Data saved successfully!")

    name_entry.delete(0, tk.END)
    grade_entry.delete(0, tk.END)

def format_excel():
    wb = load_workbook("studgrade.xlsx")
    ws = wb["Student Grade"]

    for cell in ws[1]:
        cell.font = Font(bold=True)

    for col in ws.columns:
        max_length = max(len(str(cell.value)) if cell.value else 0 for cell in col)
        col_letter = get_column_letter(col[0].column)
        ws.column_dimensions[col_letter].width = max_length + 2

    wb.save("studgrade.xlsx")

def show_data():
    wb = load_workbook("studgrade.xlsx")
    ws = wb["Student Grade"]

    data_window = tk.Toplevel(window)
    data_window.title("Student Grade")

    for i, row in enumerate(ws.iter_rows(values_only=True)):
        for j, value in enumerate(row):
            label = tk.Label(data_window, text=value, borderwidth=1, relief="solid", padx=6, pady=3)
            label.grid(row=i, column=j)

window = tk.Tk()
window.title("Student Grade")
window.geometry("230x180")
window.configure(bg="#FDE2E4") 

main_frame = tk.Frame(window, bg="#FDE2E4")
main_frame.pack(pady=10, padx=10, fill="both", expand=True)

tk.Label(main_frame, text="Name", bg="#FDE2E4").grid(row=0, column=0, padx=10, pady=5, sticky="w")
tk.Label(main_frame, text="Score", bg="#FDE2E4").grid(row=1, column=0, padx=10, pady=5, sticky="w")

name_entry = tk.Entry(main_frame, width=25, bg = "#FFF0F3")
grade_entry = tk.Entry(main_frame, width=25, bg = "#FFF0F3")

name_entry.grid(row=0, column=1, pady=5)
grade_entry.grid(row=1, column=1, pady=5)

tk.Button(main_frame, text="Submit", command=save_to_excel, width=20, bg="#FFB6C1", fg="black").grid(row=3, column=0, columnspan=2, pady=10)
tk.Button(main_frame, text="View Stored Data", command=show_data, width=20, bg="#FF9FB2", fg="black").grid(row=4, column=0, columnspan=2)

window.mainloop()
